%%

%pos int

%name Parser

%term VAR of string | TRUE | FALSE | AND | OR | IMPL | DIMPL | NOT | ALL | EXISTS | DIFF | NEGDIFF | AT | EQ | LPAREN | RPAREN | LBRACKET | RBRACKET | LCHEVRON | RCHEVRON | LBRACE | RBRACE | SEP | COLON | AST | REFLEXIVE | TRANSITIVE | SERIAL | EOF | SEMI
%nonterm START of Parsetree.parsetree option | OTHER of Parsetree.parsetree | CONJUNCTION of Parsetree.parsetree | DISJUNCTION of Parsetree.parsetree | IMPLICATION of Parsetree.parsetree | DIMPLICATION of Parsetree.parsetree | PREFIX of unit | REFLLIST of unit | TRANSLIST of unit | SERLIST of unit | VARLIST of string list

%eop EOF SEMI
%noshift EOF

%start START

%%

START :
	  IMPLICATION					(SOME IMPLICATION)
	| PREFIX IMPLICATION			(SOME IMPLICATION)
	| 								(NONE)

PREFIX :
	  REFLLIST						(())
	| TRANSLIST						(())
	| SERLIST						(())
	| REFLLIST PREFIX				(())
	| TRANSLIST PREFIX				(())
	| SERLIST PREFIX				(())

REFLLIST :
	  REFLEXIVE AST RBRACE			(RelationMgr.setAllReflexive ())
	| REFLEXIVE VARLIST RBRACE		(app RelationMgr.setReflexive VARLIST)
	| REFLEXIVE RBRACE				(())

TRANSLIST :
	  TRANSITIVE AST RBRACE			(RelationMgr.setAllTransitive ())
	| TRANSITIVE VARLIST RBRACE		(app RelationMgr.setTransitive VARLIST)
	| TRANSITIVE RBRACE				(())

SERLIST :
	  SERIAL AST RBRACE				(RelationMgr.setAllSerial ())
	| SERIAL VARLIST RBRACE			(app RelationMgr.setSerial VARLIST)
	| SERIAL RBRACE					(())

VARLIST :
	  VAR							([VAR])
	| VAR SEP VARLIST				(VAR::VARLIST)

OTHER :
	  VAR							(Parsetree.PROPVAR VAR)
	| TRUE							(Parsetree.mconj nil)
	| FALSE							(Parsetree.mdisj nil)
	| EQ VAR						(Parsetree.NOMINAL VAR)
	| LCHEVRON VAR RCHEVRON OTHER	(Parsetree.DIAMOND (VAR, OTHER))
	| LBRACKET VAR RBRACKET OTHER	(Parsetree.BOX (VAR, OTHER))
	| NOT OTHER						(Parsetree.neg OTHER)
	| ALL OTHER						(Parsetree.ALL OTHER)
	| EXISTS OTHER					(Parsetree.EXISTS OTHER)
	| DIFF OTHER					(Parsetree.DIFF OTHER)
	| NEGDIFF OTHER					(Parsetree.NEGDIFF OTHER)
	| AT VAR OTHER					(Parsetree.AT (VAR, OTHER))
	| VAR COLON OTHER				(Parsetree.AT (VAR, OTHER))
	| LPAREN IMPLICATION RPAREN		(IMPLICATION)

CONJUNCTION :
	  OTHER							(OTHER)
	| OTHER AND CONJUNCTION			(Parsetree.conj OTHER CONJUNCTION)

DISJUNCTION :
	  CONJUNCTION					(CONJUNCTION)
	| CONJUNCTION OR DISJUNCTION	(Parsetree.disj CONJUNCTION DISJUNCTION)

DIMPLICATION :
	  DISJUNCTION						(DISJUNCTION)
	| DISJUNCTION DIMPL DIMPLICATION	(Parsetree.dimpl DISJUNCTION DIMPLICATION)

IMPLICATION :
	  DIMPLICATION					(DIMPLICATION)
	| DIMPLICATION IMPL IMPLICATION	(Parsetree.impl DIMPLICATION IMPLICATION)
