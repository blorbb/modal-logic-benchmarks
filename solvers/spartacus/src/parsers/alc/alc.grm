%%

%pos int

%name Alc

%term ATOM of string | RELATION of string | TRUE | FALSE | AND | OR | NOT | BOX | DIA | LPAREN | RPAREN | IMPL | DIMPL | EOF
%nonterm START of Parsetree.parsetree | FLIST of Parsetree.parsetree list | FORMULA of Parsetree.parsetree | BOOLEAN_EXPR of Parsetree.parsetree | RULE_EXPR of Parsetree.parsetree | ATOMIC_EXPR of Parsetree.parsetree

%eop EOF
%noshift EOF

%start START

%%

START :
	  FORMULA											(FORMULA)

FLIST :
	  FORMULA											([FORMULA])
	| FORMULA FLIST										(FORMULA::FLIST)

FORMULA :
	  BOOLEAN_EXPR										(BOOLEAN_EXPR)
	| RULE_EXPR											(RULE_EXPR)
	| ATOMIC_EXPR										(ATOMIC_EXPR)

BOOLEAN_EXPR :
	  LPAREN NOT FORMULA RPAREN							(Parsetree.neg FORMULA)
	| LPAREN IMPL FORMULA FORMULA RPAREN				(Parsetree.impl FORMULA1 FORMULA2)
	| LPAREN DIMPL FORMULA FORMULA RPAREN				(Parsetree.dimpl FORMULA1 FORMULA2)
	| LPAREN AND FLIST RPAREN							(Parsetree.mconj FLIST)
	| LPAREN OR FLIST RPAREN							(Parsetree.mdisj FLIST)

RULE_EXPR :
	  LPAREN BOX RELATION FORMULA RPAREN				(Parsetree.BOX (RELATION, FORMULA))
	| LPAREN DIA RELATION FORMULA RPAREN				(Parsetree.DIAMOND (RELATION, FORMULA))

ATOMIC_EXPR :
	  ATOM												(Parsetree.PROPVAR ATOM)
	| TRUE												(Parsetree.mconj nil)
	| FALSE												(Parsetree.mdisj nil)
