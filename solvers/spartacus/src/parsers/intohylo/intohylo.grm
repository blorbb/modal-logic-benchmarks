%%

%pos int

%name Intohylo

%term PROPOSITION of string | NOMINAL of string | RELATION of string | TRUE | FALSE | AND | OR | NOT | BOX | DIA | LPAREN | RPAREN | LBRACKET | RBRACKET | LCHEVRON | RCHEVRON | IMPL | DIMPL | ALL | EXISTS | DIFF | NEGDIFF | COLON | AT | SEMI | EOF | END
%nonterm START of Parsetree.parsetree | FLIST of Parsetree.parsetree list | FORMULA of Parsetree.parsetree | CONJUNCTION of Parsetree.parsetree | DISJUNCTION of Parsetree.parsetree | IMPLICATION of Parsetree.parsetree | DIMPLICATION of Parsetree.parsetree | OTHER of Parsetree.parsetree | MOP of Parsetree.parsetree | ATOP of Parsetree.parsetree

%eop EOF END
%noshift EOF

%start START

%%

START :
	  FLIST END											(Parsetree.mconj FLIST)

FLIST :
	  FORMULA											([FORMULA])
	| FORMULA SEMI FLIST								(FORMULA::FLIST)

FORMULA :
	  DIMPLICATION										(DIMPLICATION)

OTHER :
	  TRUE												(Parsetree.mconj nil)
	| FALSE												(Parsetree.mdisj nil)
	| PROPOSITION										(Parsetree.PROPVAR PROPOSITION)
	| NOMINAL											(Parsetree.NOMINAL NOMINAL)
	| MOP												(MOP)
	| ATOP												(ATOP)
	| ALL OTHER											(Parsetree.ALL OTHER)
	| EXISTS OTHER										(Parsetree.EXISTS OTHER)
	| DIFF OTHER										(Parsetree.DIFF OTHER)
	| NEGDIFF OTHER										(Parsetree.NEGDIFF OTHER)
	| LPAREN FORMULA RPAREN								(FORMULA)
	| NOT OTHER											(Parsetree.neg OTHER)

CONJUNCTION :
	  OTHER												(OTHER)
	| OTHER AND CONJUNCTION								(Parsetree.conj OTHER CONJUNCTION)

DISJUNCTION :
	  CONJUNCTION										(CONJUNCTION)
	| CONJUNCTION OR DISJUNCTION						(Parsetree.disj CONJUNCTION DISJUNCTION)

IMPLICATION :
	  DISJUNCTION										(DISJUNCTION)
	| DISJUNCTION IMPL IMPLICATION						(Parsetree.impl DISJUNCTION IMPLICATION)

DIMPLICATION :
	  IMPLICATION										(IMPLICATION)
	| IMPLICATION DIMPL DIMPLICATION					(Parsetree.dimpl IMPLICATION DIMPLICATION)

MOP :
	  BOX OTHER											(Parsetree.BOX ("rx", OTHER))
	| LBRACKET RELATION RBRACKET OTHER					(Parsetree.BOX (RELATION, OTHER))
	| DIA OTHER											(Parsetree.DIAMOND ("rx", OTHER))
	| LCHEVRON RELATION RCHEVRON OTHER					(Parsetree.DIAMOND (RELATION, OTHER))

ATOP :
	  NOMINAL COLON OTHER								(Parsetree.AT (NOMINAL, OTHER))
	| AT NOMINAL OTHER									(Parsetree.AT (NOMINAL, OTHER))
