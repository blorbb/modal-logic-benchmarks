%%

%pos int

%name Ksatc

%term VAR of string | TRUE | FALSE | AND | OR | NOT | BOX | LPAREN | RPAREN | EOF
%nonterm START of Parsetree.parsetree | FORMULA of Parsetree.parsetree | BOOLEAN_EXPR of Parsetree.parsetree | FLIST of Parsetree.parsetree list | RULE_EXPR of Parsetree.parsetree | ATOMIC_EXPR of Parsetree.parsetree

%eop EOF
%noshift EOF

%start START

%%

START :
	  FORMULA											(FORMULA)

FORMULA :
	  BOOLEAN_EXPR										(BOOLEAN_EXPR)
	| RULE_EXPR											(RULE_EXPR)
	| ATOMIC_EXPR										(ATOMIC_EXPR)

FLIST :
	  FORMULA											([FORMULA])
	| FORMULA FLIST										(FORMULA::FLIST)

BOOLEAN_EXPR :
	  AND LPAREN FLIST RPAREN							(Parsetree.mconj FLIST)
	| OR LPAREN FLIST RPAREN							(Parsetree.mdisj FLIST)
	| NOT AND LPAREN FLIST RPAREN						(Parsetree.neg (Parsetree.mconj FLIST))
	| NOT OR LPAREN FLIST RPAREN						(Parsetree.neg (Parsetree.mdisj FLIST))

RULE_EXPR :
	  BOX LPAREN VAR RPAREN LPAREN FORMULA RPAREN		(Parsetree.BOX (VAR, FORMULA))
	| NOT BOX LPAREN VAR RPAREN LPAREN FORMULA RPAREN	(Parsetree.neg (Parsetree.BOX (VAR, FORMULA)))

ATOMIC_EXPR :
	  VAR												(Parsetree.PROPVAR VAR)
	| NOT VAR											(Parsetree.neg (Parsetree.PROPVAR VAR))
	| TRUE												(Parsetree.mconj nil)
	| FALSE												(Parsetree.mdisj nil)
