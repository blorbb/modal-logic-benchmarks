			     val yypos: int = i0+ !yygone
			open UserDeclarations Internal.StartStates
 in (yybufpos := i; case yyk of 

			(* Application actions *)

  10 => (pos := (!pos + 1); lex ())
| 13 => (lex ())
| 17 => (Tokens.END (!pos, !pos))
| 21 => let val yytext=yymktext() in Tokens.NEW (Option.valOf (Int.fromString yytext), !pos, !pos) end
| 25 => (Tokens.BOX (!pos, !pos))
| 29 => (Tokens.DIA (!pos, !pos))
| 35 => (Tokens.FALSE (!pos, !pos))
| 40 => (Tokens.TRUE (!pos, !pos))
| 42 => (Tokens.AND (!pos, !pos))
| 44 => (Tokens.OR (!pos, !pos))
| 47 => (Tokens.IMPL (!pos, !pos))
| 50 => (Tokens.IMPL (!pos, !pos))
| 54 => (Tokens.EQUIV (!pos, !pos))
| 58 => (Tokens.EQUIV (!pos, !pos))
| 60 => (Tokens.NOT (!pos, !pos))
| 62 => (Tokens.LPAREN (!pos, !pos))
| 64 => (Tokens.RPAREN (!pos, !pos))
| 68 => let val yytext=yymktext() in Tokens.VAR (yytext, !pos, !pos) end
| 70 => (print "WARNING: ignoring invalid character\n"; lex ())
| 8 => (pos := (!pos + 2); lex ())
