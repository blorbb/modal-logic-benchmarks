%%

%pos int

%name Lwb

%term VAR of string | NEW of int | TRUE | FALSE | AND | OR | IMPL | EQUIV | NOT | DIA | BOX | LPAREN | RPAREN | EOF | END
%nonterm START of (int * Parsetree.parsetree) list | FLIST of (int * Parsetree.parsetree) list | OTHER of Parsetree.parsetree | CONJUNCTION of Parsetree.parsetree | DISJUNCTION of Parsetree.parsetree | IMPLICATION of Parsetree.parsetree

%eop EOF END
%noshift EOF

%start START

%%

START :
	  FLIST END						(FLIST)

FLIST :
	  NEW IMPLICATION				([(NEW, IMPLICATION)])
	| NEW IMPLICATION FLIST			((NEW, IMPLICATION)::FLIST)

OTHER :
	  VAR							(Parsetree.PROPVAR VAR)
	| TRUE							(Parsetree.mconj nil)
	| FALSE							(Parsetree.mdisj nil)
	| DIA OTHER						(Parsetree.DIAMOND ("r", OTHER))
	| BOX OTHER						(Parsetree.BOX ("r", OTHER))
	| NOT OTHER						(Parsetree.neg OTHER)
	| LPAREN IMPLICATION RPAREN		(IMPLICATION)

CONJUNCTION :
	  OTHER							(OTHER)
	| OTHER AND CONJUNCTION			(Parsetree.conj OTHER CONJUNCTION)

DISJUNCTION :
	  CONJUNCTION					(CONJUNCTION)
	| CONJUNCTION OR DISJUNCTION	(Parsetree.disj CONJUNCTION DISJUNCTION)

IMPLICATION :
	  DISJUNCTION					(DISJUNCTION)
	| DISJUNCTION IMPL IMPLICATION	(Parsetree.impl DISJUNCTION IMPLICATION)
	| DISJUNCTION EQUIV IMPLICATION (Parsetree.dimpl DISJUNCTION IMPLICATION)
