type int = Int.int
fun makeLexer (yyinput: int -> string) =
let	val yygone0:int= ~1
	val yyb = ref "\n" 		(* buffer *)
	val yybl: int ref = ref 1		(*buffer length *)
	val yybufpos: int ref = ref 1		(* location of next character to use *)
	val yygone: int ref = ref yygone0	(* position in file of beginning of buffer *)
	val yydone = ref false		(* eof found yet? *)
	val yybegin: int ref = ref 1		(*Current 'start state' for lexer *)

	val YYBEGIN = fn (Internal.StartStates.STARTSTATE x) =>
		 yybegin := x

fun lex () : Internal.result =
let fun continue() = lex() in
  let fun scan (s,AcceptingLeaves : Internal.yyfinstate list list,l,i0: int) =
	let fun action (i: int,nil) = raise LexError
	| action (i,nil::l) = action (i-1,l)
	| action (i,(node::acts)::l) =
		case node of
		    Internal.N yyk => 
			(let fun yymktext() = String.substring(!yyb,i0,i-i0)
			     val yypos: int = i0+ !yygone
			open UserDeclarations Internal.StartStates
 in (yybufpos := i; case yyk of 

			(* Application actions *)

  1 => (pos := (!pos + 1); lex ())
| 1003 => (Exn.error "Token \"IrreflexiveProperty\" not supported")
| 1027 => (Tokens.T_SYMMETRIC_PROPERTY (!pos, !pos))
| 105 => (Tokens.T_SOME_VALUES_FROM (!pos, !pos))
| 1052 => (Exn.error "Token \"AsymmetricProperties\" not supported")
| 1077 => (Tokens.T_TRANSITIVE_PROPERTY (!pos, !pos))
| 11 => let val yytext=yymktext() in Tokens.T_XSTRING (yytext, !pos, !pos) end
| 1101 => (Tokens.T_PROPERTY_ASSERTION (!pos, !pos))
| 1133 => (Tokens.T_NEGATIVE_PROPERTY_ASSERTION (!pos, !pos))
| 1136 => let val yytext=yymktext() in Tokens.T_STRING (yytext, !pos, !pos) end
| 1138 => (print "WARNING: ignoring invalid character\n"; lex ())
| 119 => (Tokens.T_ALL_VALUES_FROM (!pos, !pos))
| 128 => (Tokens.T_HAS_VALUE (!pos, !pos))
| 136 => (Exn.error "Token \"HasSelf\" not supported")
| 15 => (lex ())
| 151 => (Exn.error "Token \"MinCardinality\" not supported")
| 166 => (Exn.error "Token \"MaxCardinality\" not supported")
| 18 => (lex ())
| 183 => (Exn.error "Token \"ExactCardinality\" not supported")
| 194 => (Tokens.T_SUB_CLASS_OF (!pos, !pos))
| 212 => (Tokens.T_EQUIVALENT_CLASSES (!pos, !pos))
| 228 => (Tokens.T_DISJOINT_CLASSES (!pos, !pos))
| 242 => (Tokens.T_DISJOINT_UNION (!pos, !pos))
| 256 => (Tokens.T_SUB_PROPERTY_OF (!pos, !pos))
| 277 => (Exn.error "Token \"EquivalentProperties\" not supported")
| 28 => (Exn.error "Token \"InverseOf\" not supported")
| 296 => (Exn.error "Token \"DisjointProperties\" not supported")
| 311 => (Exn.error "Token \"PropertyDomain\" not supported")
| 325 => (Exn.error "Token \"PropertyRange\" not supported")
| 343 => (Exn.error "Token \"InverseProperties\" not supported")
| 362 => (Exn.error "Token \"FunctionalProperty\" not supported")
| 388 => (Exn.error "Token \"InverseFunctionalProperty\" not supported")
| 406 => (Tokens.T_REFLEXIVE_PROPERTY (!pos, !pos))
| 426 => (Exn.error "Token \"IrreflexiveProperty\" not supported")
| 43 => (Tokens.T_INTERSECTION_OF (!pos, !pos))
| 444 => (Tokens.T_SYMMETRIC_PROPERTY (!pos, !pos))
| 463 => (Exn.error "Token \"AsymmetricProperties\" not supported")
| 482 => (Tokens.T_TRANSITIVE_PROPERTY (!pos, !pos))
| 489 => (Exn.error "Token \"HasKey\" not supported")
| 504 => (Tokens.T_SAME_INDIVIDUAL (!pos, !pos))
| 51 => (Tokens.T_UNION_OF (!pos, !pos))
| 520 => (Tokens.T_SAME_INDIVIDUAL (!pos, !pos))
| 541 => (Tokens.T_DIFFERENT_INDIVIDUALS (!pos, !pos))
| 561 => (Tokens.T_DIFFERENT_INDIVIDUALS (!pos, !pos))
| 576 => (Tokens.T_CLASS_ASSERTION (!pos, !pos))
| 594 => (Tokens.T_PROPERTY_ASSERTION (!pos, !pos))
| 620 => (Tokens.T_NEGATIVE_PROPERTY_ASSERTION (!pos, !pos))
| 630 => (Tokens.T_NAMESPACE (!pos, !pos))
| 639 => (Tokens.T_ONTOLOGY (!pos, !pos))
| 64 => (Tokens.T_COMPLEMENT_OF (!pos, !pos))
| 647 => (Tokens.T_IMPORTS (!pos, !pos))
| 654 => (Tokens.T_IMPORTS (!pos, !pos))
| 665 => (Tokens.T_ANNOTATION (!pos, !pos))
| 672 => (Exn.error "Token \"Import\" not supported")
| 684 => (Tokens.T_DECLARATION (!pos, !pos))
| 690 => (Tokens.T_CLASS (!pos, !pos))
| 699 => (Tokens.T_CLASS (!pos, !pos))
| 70 => (Tokens.T_ONE_OF (!pos, !pos))
| 714 => (Tokens.T_OBJECT_PROPERTY (!pos, !pos))
| 733 => (Tokens.T_ANNOTATION_PROPERTY (!pos, !pos))
| 749 => (Tokens.T_NAMED_INDIVIDUAL (!pos, !pos))
| 766 => (Tokens.T_ENTITY_ANNOTATION (!pos, !pos))
| 772 => (Tokens.T_LABEL (!pos, !pos))
| 780 => (Tokens.T_COMMENT (!pos, !pos))
| 790 => (Tokens.T_TOP (!pos, !pos))
| 802 => (Tokens.T_BOTTOM (!pos, !pos))
| 805 => let val yytext=yymktext() in Tokens.T_NON_NEGATIVE_INTEGER (yytext, !pos, !pos) end
| 807 => (Tokens.T_LPAREN (!pos, !pos))
| 809 => (Tokens.T_RPAREN (!pos, !pos))
| 811 => (Tokens.T_EQS (!pos, !pos))
| 832 => (Tokens.T_INTERSECTION_OF (!pos, !pos))
| 846 => (Tokens.T_UNION_OF (!pos, !pos))
| 865 => (Tokens.T_COMPLEMENT_OF (!pos, !pos))
| 877 => (Tokens.T_ONE_OF (!pos, !pos))
