fun disjointClasses (x::y::nil) = Parsetree.disj (Parsetree.neg x) (Parsetree.neg y)
  | disjointClasses (x::xr) =
		Parsetree.conj
			(Parsetree.disj (Parsetree.neg x) (Parsetree.mconj (map Parsetree.neg xr)))
			(disjointClasses xr)
  | disjointClasses _ = Exn.unexpArg "OwlFs.grm.disjointClasses"

fun disjointUnion c xr =
	Parsetree.conj
		(Parsetree.dimpl c (Parsetree.mdisj xr))
		(disjointClasses xr)

fun sameIndividual (x::xr) = Parsetree.AT (x, Parsetree.mconj (map Parsetree.NOMINAL xr))
  | sameIndividual nil = Exn.unexpArg "OwlFs.grm.sameIndividual"

fun differentIndividuals xs =
	let
		fun f x y = if x = y then NONE else SOME (Parsetree.NEG (Parsetree.NOMINAL y))
		
		fun g x = Parsetree.AT (x, Parsetree.mconj (List.mapPartial (f x) xs))
	in
		Parsetree.mconj (map g xs)
	end

%%

%pos int

%name OwlFs

%term
  T_XSTRING of string
| T_INTERSECTION_OF
| T_UNION_OF
| T_COMPLEMENT_OF
| T_ONE_OF
| T_SOME_VALUES_FROM
| T_ALL_VALUES_FROM
| T_HAS_VALUE
| T_SUB_CLASS_OF
| T_EQUIVALENT_CLASSES
| T_DISJOINT_CLASSES
| T_DISJOINT_UNION
| T_SUB_PROPERTY_OF
| T_REFLEXIVE_PROPERTY
| T_SYMMETRIC_PROPERTY
| T_TRANSITIVE_PROPERTY
| T_SAME_INDIVIDUAL
| T_DIFFERENT_INDIVIDUALS
| T_CLASS_ASSERTION
| T_PROPERTY_ASSERTION
| T_NEGATIVE_PROPERTY_ASSERTION
| T_NAMESPACE
| T_ONTOLOGY
| T_IMPORTS
| T_ANNOTATION
| T_DECLARATION
| T_CLASS
| T_OBJECT_PROPERTY
| T_ANNOTATION_PROPERTY
| T_NAMED_INDIVIDUAL
| T_TOP
| T_BOTTOM
| T_NON_NEGATIVE_INTEGER of string
| T_ENTITY_ANNOTATION
| T_LABEL
| T_COMMENT
| T_LPAREN
| T_RPAREN
| T_EQS
| T_STRING of string
| EOF
%nonterm
  NAMESPACE of string
| PREFIX of string
| IRI of string
| ONTOLOGY_DOCUMENT of string list * Parsetree.parsetree
| PREFIX_DEFINITION
| ONTOLOGY of string list * Parsetree.parsetree
| ONTOLOGY_IRI of string
| VERSION_IRI of string
| DIRECTLY_IMPORTS_DOCUMENT of string
| AXIOMS of Parsetree.parsetree
| DECLARATION
| ENTITY
| CLASS of Parsetree.parsetree
| OBJECT_PROPERTY of string
| INDIVIDUAL of string
| NAMED_INDIVIDUAL of string
| OBJECT_PROPERTY_EXPRESSION of string
| CLASS_EXPRESSION of Parsetree.parsetree
| OBJECT_INTERSECTION_OF of Parsetree.parsetree
| OBJECT_UNION_OF of Parsetree.parsetree
| OBJECT_COMPLEMENT_OF of Parsetree.parsetree
| OBJECT_ONE_OF of Parsetree.parsetree
| OBJECT_SOME_VALUES_FROM of Parsetree.parsetree
| OBJECT_ALL_VALUES_FROM of Parsetree.parsetree
| OBJECT_HAS_VALUE of Parsetree.parsetree
| AXIOM of Parsetree.parsetree option
| AXIOM_ANNOTATIONS
| ANNOTATION
| CLASS_AXIOM of Parsetree.parsetree
| SUB_CLASS_OF of Parsetree.parsetree
| SUB_CLASS_EXPRESSION of Parsetree.parsetree
| SUPER_CLASS_EXPRESSION of Parsetree.parsetree
| EQUIVALENT_CLASSES of Parsetree.parsetree
| DISJOINT_CLASSES of Parsetree.parsetree
| DISJOINT_UNION of Parsetree.parsetree
| DISJOINT_CLASS_EXPRESSIONS of Parsetree.parsetree list
| OBJECT_PROPERTY_AXIOM
| SUB_OBJECT_PROPERTY_EXPRESSION of string
| SUB_OBJECT_PROPERTY_OF
| REFLEXIVE_OBJECT_PROPERTY
| SYMMETRIC_OBJECT_PROPERTY
| TRANSITIVE_OBJECT_PROPERTY
| ASSERTION of Parsetree.parsetree
| SOURCE_INDIVIDUAL of string
| TARGET_INDIVIDUAL of string
| SAME_INDIVIDUAL of Parsetree.parsetree
| DIFFERENT_INDIVIDUALS of Parsetree.parsetree
| CLASS_ASSERTION of Parsetree.parsetree
| OBJECT_PROPERTY_ASSERTION of Parsetree.parsetree
| NEGATIVE_OBJECT_PROPERTY_ASSERTION of Parsetree.parsetree
| CLASS_EXPRESSIONS of Parsetree.parsetree list
| INDIVIDUALS of string list
| ANNOTATIONS
| PREFIX_DEFINITIONS
| DIDOA of string list
| ANNOTATIONS_FOR_AXIOM
| ANNOTATIONS_FOR_ENTITY
| ENTITY_ANNOTATION
| ANNOTATION_BY_CONSTANT
| ANNOTATION_BY_ENTITY
| CONSTANT of string


%eop EOF
%noshift EOF

%start ONTOLOGY_DOCUMENT

%%

NAMESPACE
	: T_STRING											(T_STRING)
	| T_XSTRING											(T_XSTRING)

PREFIX
	: T_STRING											(T_STRING)
	| T_XSTRING											(T_XSTRING)

IRI
	: T_STRING											(T_STRING)
	| T_XSTRING											(T_XSTRING)

ONTOLOGY_DOCUMENT
	: PREFIX_DEFINITIONS ONTOLOGY						(ONTOLOGY)

PREFIX_DEFINITION
	: T_NAMESPACE T_LPAREN T_EQS NAMESPACE T_RPAREN				(())
	| T_NAMESPACE T_LPAREN PREFIX T_EQS NAMESPACE T_RPAREN		(())

ONTOLOGY
	: T_ONTOLOGY T_LPAREN DIDOA AXIOMS T_RPAREN
		(DIDOA, AXIOMS)
	| T_ONTOLOGY T_LPAREN ONTOLOGY_IRI DIDOA AXIOMS T_RPAREN			
		(DIDOA, AXIOMS)
	| T_ONTOLOGY T_LPAREN ONTOLOGY_IRI VERSION_IRI DIDOA AXIOMS T_RPAREN
		(DIDOA, AXIOMS)

ONTOLOGY_IRI
	: IRI												((IRI))

VERSION_IRI
	: IRI												((IRI))

DIRECTLY_IMPORTS_DOCUMENT
	: T_IMPORTS T_LPAREN IRI T_RPAREN					(IRI)

AXIOMS
	: 													(Parsetree.mconj nil)
	| AXIOM AXIOMS										(Parsetree.conj (Option.getOpt (AXIOM, Parsetree.mconj nil)) AXIOMS)

DECLARATION
	: T_DECLARATION T_LPAREN AXIOM_ANNOTATIONS ENTITY T_RPAREN			(())

ENTITY
	: T_CLASS T_LPAREN CLASS T_RPAREN									(())
	| T_OBJECT_PROPERTY T_LPAREN OBJECT_PROPERTY T_RPAREN				(())
	| T_NAMED_INDIVIDUAL T_LPAREN NAMED_INDIVIDUAL T_RPAREN				(())

AXIOM_ANNOTATIONS
	: ANNOTATIONS										(())

ANNOTATION
	: ANNOTATION_BY_CONSTANT							(())
	| ANNOTATION_BY_ENTITY								(())

CLASS
	: T_TOP												(Parsetree.mconj nil)
	| T_BOTTOM											(Parsetree.mdisj nil)
	| IRI												(Parsetree.PROPVAR IRI)

OBJECT_PROPERTY
	: IRI												(IRI)

INDIVIDUAL
	: NAMED_INDIVIDUAL									(NAMED_INDIVIDUAL)

NAMED_INDIVIDUAL
	: IRI												(IRI)

OBJECT_PROPERTY_EXPRESSION
	: OBJECT_PROPERTY									(OBJECT_PROPERTY)

CLASS_EXPRESSION
	: CLASS												(CLASS)
	| OBJECT_INTERSECTION_OF							(OBJECT_INTERSECTION_OF)
	| OBJECT_UNION_OF									(OBJECT_UNION_OF)
	| OBJECT_COMPLEMENT_OF								(OBJECT_COMPLEMENT_OF)
	| OBJECT_ONE_OF										(OBJECT_ONE_OF)
	| OBJECT_SOME_VALUES_FROM							(OBJECT_SOME_VALUES_FROM)
	| OBJECT_ALL_VALUES_FROM							(OBJECT_ALL_VALUES_FROM)
	| OBJECT_HAS_VALUE									(OBJECT_HAS_VALUE)

OBJECT_INTERSECTION_OF
	: T_INTERSECTION_OF T_LPAREN CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSIONS T_RPAREN
		(Parsetree.mconj (CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSIONS))

OBJECT_UNION_OF
	: T_UNION_OF T_LPAREN CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSIONS T_RPAREN
		(Parsetree.mdisj (CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSIONS))

OBJECT_COMPLEMENT_OF
	: T_COMPLEMENT_OF T_LPAREN CLASS_EXPRESSION T_RPAREN
		(Parsetree.neg CLASS_EXPRESSION)

OBJECT_ONE_OF
	: T_ONE_OF T_LPAREN INDIVIDUAL INDIVIDUALS T_RPAREN
		(Parsetree.mdisj (map Parsetree.NOMINAL (INDIVIDUAL::INDIVIDUALS)))

OBJECT_SOME_VALUES_FROM
	: T_SOME_VALUES_FROM T_LPAREN OBJECT_PROPERTY_EXPRESSION CLASS_EXPRESSION T_RPAREN
		(Parsetree.DIAMOND (OBJECT_PROPERTY_EXPRESSION, CLASS_EXPRESSION))

OBJECT_ALL_VALUES_FROM
	: T_ALL_VALUES_FROM T_LPAREN OBJECT_PROPERTY_EXPRESSION CLASS_EXPRESSION T_RPAREN
		(Parsetree.BOX (OBJECT_PROPERTY_EXPRESSION, CLASS_EXPRESSION))

OBJECT_HAS_VALUE
	: T_HAS_VALUE T_LPAREN OBJECT_PROPERTY_EXPRESSION INDIVIDUAL T_RPAREN
		(Parsetree.DIAMOND (OBJECT_PROPERTY_EXPRESSION, Parsetree.NOMINAL INDIVIDUAL))

AXIOM
	: DECLARATION										(NONE)
	| CLASS_AXIOM										(SOME (Parsetree.ALL (CLASS_AXIOM)))
	| OBJECT_PROPERTY_AXIOM								(NONE)
(*	| DATA_PROPERTY_AXIOM*)
(*	| HAS_KEY*)
	| ASSERTION											(SOME ASSERTION)
	| ENTITY_ANNOTATION									(NONE)

CLASS_AXIOM
	: SUB_CLASS_OF										(SUB_CLASS_OF)
	| EQUIVALENT_CLASSES								(EQUIVALENT_CLASSES)
	| DISJOINT_CLASSES									(DISJOINT_CLASSES)
	| DISJOINT_UNION									(DISJOINT_UNION)

SUB_CLASS_OF
	: T_SUB_CLASS_OF T_LPAREN AXIOM_ANNOTATIONS SUB_CLASS_EXPRESSION SUPER_CLASS_EXPRESSION T_RPAREN
		(Parsetree.impl SUB_CLASS_EXPRESSION SUPER_CLASS_EXPRESSION)

SUB_CLASS_EXPRESSION
	: CLASS_EXPRESSION									(CLASS_EXPRESSION)

SUPER_CLASS_EXPRESSION
	: CLASS_EXPRESSION									(CLASS_EXPRESSION)

EQUIVALENT_CLASSES
	: T_EQUIVALENT_CLASSES T_LPAREN AXIOM_ANNOTATIONS CLASS_EXPRESSION CLASS_EXPRESSION T_RPAREN
		(Parsetree.dimpl CLASS_EXPRESSION1 CLASS_EXPRESSION2)
	| T_EQUIVALENT_CLASSES T_LPAREN AXIOM_ANNOTATIONS CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSIONS T_RPAREN
		(Parsetree.disj
			(Parsetree.mconj (CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSION3::CLASS_EXPRESSIONS))
			(Parsetree.mconj (map Parsetree.neg
				(CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSION3::CLASS_EXPRESSIONS)))
		)

DISJOINT_CLASSES
	: T_DISJOINT_CLASSES T_LPAREN AXIOM_ANNOTATIONS CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSIONS T_RPAREN
		(disjointClasses (CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSIONS))

DISJOINT_UNION
	: T_DISJOINT_UNION T_LPAREN AXIOM_ANNOTATIONS CLASS DISJOINT_CLASS_EXPRESSIONS T_RPAREN
		(disjointUnion CLASS DISJOINT_CLASS_EXPRESSIONS)

DISJOINT_CLASS_EXPRESSIONS
	: CLASS_EXPRESSION CLASS_EXPRESSION CLASS_EXPRESSIONS
		(CLASS_EXPRESSION1::CLASS_EXPRESSION2::CLASS_EXPRESSIONS)

OBJECT_PROPERTY_AXIOM
	: SUB_OBJECT_PROPERTY_OF							(())
	| REFLEXIVE_OBJECT_PROPERTY							(())
	| SYMMETRIC_OBJECT_PROPERTY							(())
	| TRANSITIVE_OBJECT_PROPERTY						(())

SUB_OBJECT_PROPERTY_EXPRESSION
	: OBJECT_PROPERTY_EXPRESSION						(OBJECT_PROPERTY_EXPRESSION)

SUB_OBJECT_PROPERTY_OF
	: T_SUB_PROPERTY_OF T_LPAREN AXIOM_ANNOTATIONS SUB_OBJECT_PROPERTY_EXPRESSION OBJECT_PROPERTY_EXPRESSION T_RPAREN
		(RelationMgr.setSubrelation (SUB_OBJECT_PROPERTY_EXPRESSION, OBJECT_PROPERTY_EXPRESSION))

REFLEXIVE_OBJECT_PROPERTY
	: T_REFLEXIVE_PROPERTY T_LPAREN AXIOM_ANNOTATIONS OBJECT_PROPERTY_EXPRESSION T_RPAREN
		(RelationMgr.setReflexive OBJECT_PROPERTY_EXPRESSION)

SYMMETRIC_OBJECT_PROPERTY
	: T_SYMMETRIC_PROPERTY T_LPAREN AXIOM_ANNOTATIONS OBJECT_PROPERTY_EXPRESSION T_RPAREN
		(RelationMgr.setSymmetric OBJECT_PROPERTY_EXPRESSION)

TRANSITIVE_OBJECT_PROPERTY
	: T_TRANSITIVE_PROPERTY T_LPAREN AXIOM_ANNOTATIONS OBJECT_PROPERTY_EXPRESSION T_RPAREN
		(RelationMgr.setTransitive OBJECT_PROPERTY_EXPRESSION)

ASSERTION
	: SAME_INDIVIDUAL									(SAME_INDIVIDUAL)
	| DIFFERENT_INDIVIDUALS								(DIFFERENT_INDIVIDUALS)
	| CLASS_ASSERTION									(CLASS_ASSERTION)
	| OBJECT_PROPERTY_ASSERTION							(OBJECT_PROPERTY_ASSERTION)
	| NEGATIVE_OBJECT_PROPERTY_ASSERTION				(NEGATIVE_OBJECT_PROPERTY_ASSERTION)

SOURCE_INDIVIDUAL
	: INDIVIDUAL										(INDIVIDUAL)

TARGET_INDIVIDUAL
	: INDIVIDUAL										(INDIVIDUAL)

SAME_INDIVIDUAL
	: T_SAME_INDIVIDUAL T_LPAREN INDIVIDUAL INDIVIDUAL INDIVIDUALS T_RPAREN
		(sameIndividual (INDIVIDUAL1::INDIVIDUAL2::INDIVIDUALS))

DIFFERENT_INDIVIDUALS
	: T_DIFFERENT_INDIVIDUALS T_LPAREN INDIVIDUAL INDIVIDUAL INDIVIDUALS T_RPAREN
		(differentIndividuals (INDIVIDUAL1::INDIVIDUAL2::INDIVIDUALS))

CLASS_ASSERTION
	: T_CLASS_ASSERTION T_LPAREN AXIOM_ANNOTATIONS INDIVIDUAL CLASS_EXPRESSION T_RPAREN
		(Parsetree.AT (INDIVIDUAL, CLASS_EXPRESSION))

OBJECT_PROPERTY_ASSERTION
	: T_PROPERTY_ASSERTION T_LPAREN AXIOM_ANNOTATIONS OBJECT_PROPERTY_EXPRESSION SOURCE_INDIVIDUAL TARGET_INDIVIDUAL T_RPAREN
		(Parsetree.AT (SOURCE_INDIVIDUAL, Parsetree.DIAMOND (OBJECT_PROPERTY_EXPRESSION, Parsetree.NOMINAL TARGET_INDIVIDUAL)))

NEGATIVE_OBJECT_PROPERTY_ASSERTION
	: T_NEGATIVE_PROPERTY_ASSERTION T_LPAREN AXIOM_ANNOTATIONS OBJECT_PROPERTY_EXPRESSION SOURCE_INDIVIDUAL TARGET_INDIVIDUAL T_RPAREN
		(Parsetree.AT (SOURCE_INDIVIDUAL, Parsetree.NEG (Parsetree.DIAMOND (OBJECT_PROPERTY_EXPRESSION, Parsetree.NOMINAL TARGET_INDIVIDUAL))))

CLASS_EXPRESSIONS
	:													(nil)
	| CLASS_EXPRESSION CLASS_EXPRESSIONS				(CLASS_EXPRESSION::CLASS_EXPRESSIONS)

INDIVIDUALS
	:													(nil)
	| INDIVIDUAL INDIVIDUALS							(INDIVIDUAL::INDIVIDUALS)

ANNOTATIONS
	:													(())
	| ANNOTATION ANNOTATIONS							(())

PREFIX_DEFINITIONS
	:													(())
	| PREFIX_DEFINITION PREFIX_DEFINITIONS				(())

DIDOA
	:													(nil)
	| DIRECTLY_IMPORTS_DOCUMENT DIDOA					(DIRECTLY_IMPORTS_DOCUMENT::DIDOA)
	| ANNOTATION DIDOA							(DIDOA)

ANNOTATIONS_FOR_AXIOM
	: ANNOTATIONS										(())

ANNOTATIONS_FOR_ENTITY
	: ANNOTATIONS										(())

ENTITY_ANNOTATION
	: T_ENTITY_ANNOTATION T_LPAREN ANNOTATIONS_FOR_AXIOM ENTITY ANNOTATIONS_FOR_ENTITY T_RPAREN
		(())

ANNOTATION_BY_CONSTANT
	: T_ANNOTATION T_LPAREN IRI CONSTANT T_RPAREN		(())
	| T_LABEL T_LPAREN CONSTANT T_RPAREN				(())
	| T_COMMENT T_LPAREN CONSTANT T_RPAREN				(())

ANNOTATION_BY_ENTITY
	: T_ANNOTATION T_LPAREN IRI ENTITY T_RPAREN			(())

CONSTANT
	: IRI												((IRI))
