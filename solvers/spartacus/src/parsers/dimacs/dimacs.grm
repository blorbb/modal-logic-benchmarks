%%

%pos int

%name Dimacs

%term VAR of string | AND | OR | NOT | XOR | EQUAL | LPAREN | RPAREN | ZERO | EOF | END | SAT | CNF | P
%nonterm START of Parsetree.parsetree | FLIST of Parsetree.parsetree list | FORMULA of Parsetree.parsetree | CLAUSES of Parsetree.parsetree list | CLAUSE of Parsetree.parsetree list | LITERAL of Parsetree.parsetree

%eop EOF END
%noshift EOF

%start START

%%

START :
	  CNF CLAUSES										(Parsetree.mconj CLAUSES)
	| SAT FORMULA										(FORMULA)

CLAUSES :
	  CLAUSE ZERO										([Parsetree.mdisj CLAUSE])
	| CLAUSE ZERO CLAUSES								((Parsetree.mdisj CLAUSE)::CLAUSES)

CLAUSE :
	  LITERAL											([LITERAL])
	| LITERAL CLAUSE									(LITERAL::CLAUSE)

LITERAL :
	  VAR												(Parsetree.PROPVAR ("p" ^ VAR))
	| NOT VAR											(Parsetree.neg (Parsetree.PROPVAR ("p" ^ VAR)))

FORMULA :
	  VAR												(Parsetree.PROPVAR ("p" ^ VAR))
	| LPAREN FORMULA RPAREN								(FORMULA)
	| NOT LPAREN FORMULA RPAREN							(Parsetree.neg FORMULA)
	| AND LPAREN FLIST RPAREN							(Parsetree.mconj FLIST)
	| OR LPAREN FLIST RPAREN							(Parsetree.mdisj FLIST)
	| XOR LPAREN FLIST RPAREN							(Parsetree.mxor FLIST)
	| EQUAL LPAREN FLIST RPAREN							(Parsetree.mequal FLIST)

FLIST :
	  FORMULA											([FORMULA])
	| FORMULA FLIST										(FORMULA::FLIST)
