%%

%pos int

%name Dfg

%term VAR of string | TRUE | FALSE | AND | OR | IMPL | NOT | DIA | BOX | LPAREN | RPAREN | SEP | AXIOMS | CONJECTURES | NONE | EOF | END
%nonterm START of Parsetree.parsetree | AXLIST of Parsetree.parsetree list | CJLIST of Parsetree.parsetree list | FLIST of Parsetree.parsetree list | FORMULA of Parsetree.parsetree | SLIST of Parsetree.parsetree list

%eop EOF END
%noshift EOF

%start START

%%

START :
	  AXLIST CJLIST								(Parsetree.mdisj CJLIST)

AXLIST :
	  AXIOMS NONE								(nil)
	| AXIOMS FLIST								(Exn.unexpected "Input contains axioms")

CJLIST :
	  CONJECTURES NONE							(nil)
	| CONJECTURES FLIST							(FLIST)

FLIST :
	  FORMULA									([FORMULA])
	| FORMULA FLIST								(FORMULA::FLIST)

FORMULA :
	  VAR										(Parsetree.PROPVAR VAR)
	| TRUE										(Parsetree.mconj nil)
	| FALSE										(Parsetree.mdisj nil)
	| DIA LPAREN VAR SEP FORMULA RPAREN			(Parsetree.DIAMOND (VAR, FORMULA))
	| BOX LPAREN VAR SEP FORMULA RPAREN			(Parsetree.BOX (VAR, FORMULA))
	| AND LPAREN SLIST RPAREN					(Parsetree.mconj SLIST)
	| OR LPAREN SLIST RPAREN					(Parsetree.mdisj SLIST)
	| IMPL LPAREN FORMULA SEP FORMULA RPAREN	(Parsetree.impl FORMULA1 FORMULA2)
	| NOT LPAREN FORMULA RPAREN					(Parsetree.neg FORMULA)
	| LPAREN FORMULA RPAREN						(FORMULA)

SLIST :
	  FORMULA									([FORMULA])
	| FORMULA SEP SLIST							(FORMULA::SLIST)

