%%

%pos int

%name Tancs

%term INPUTFORMULA | LPAREN | RPAREN | COMMA | PERIOD | COLON | HYPOTHESIS | CONJECTURE | BOX | POS | TRUE | FALSE | NOT | OR | AND | IMPL | VAR of string | EOF
%nonterm START of Parsetree.parsetree | FLIST of (Parsetree.parsetree list * Parsetree.parsetree list) | HFORMULA of Parsetree.parsetree | CFORMULA of Parsetree.parsetree | IMPLICATION of Parsetree.parsetree | DISJUNCTION of Parsetree.parsetree | CONJUNCTION of Parsetree.parsetree | LITERAL of Parsetree.parsetree

%eop EOF
%noshift EOF

%start START

%%

START :
	  FLIST							(Parsetree.disj (Parsetree.mdisj (map Parsetree.neg (#1 FLIST))) (Parsetree.mconj (#2 FLIST)))

FLIST :
	  CFORMULA						(nil, [CFORMULA])
	| HFORMULA						([HFORMULA], nil)
	| CFORMULA FLIST				(#1 FLIST, CFORMULA::(#2 FLIST))
	| HFORMULA FLIST				(HFORMULA::(#1 FLIST), #2 FLIST)

CFORMULA :
	  INPUTFORMULA LPAREN VAR COMMA CONJECTURE COMMA IMPLICATION RPAREN PERIOD		(IMPLICATION)

HFORMULA :
	  INPUTFORMULA LPAREN VAR COMMA HYPOTHESIS COMMA IMPLICATION RPAREN PERIOD		(IMPLICATION)

LITERAL :
	  TRUE							(Parsetree.mconj nil)
	| FALSE							(Parsetree.mdisj nil)
	| VAR							(Parsetree.PROPVAR VAR)
	| NOT LITERAL					(Parsetree.neg LITERAL)
	| BOX VAR COLON LITERAL			(Parsetree.BOX (VAR, LITERAL))
	| POS VAR COLON LITERAL			(Parsetree.DIAMOND (VAR, LITERAL))
	| LPAREN IMPLICATION RPAREN		(IMPLICATION)

CONJUNCTION :
	  LITERAL						(LITERAL)
	| LITERAL AND CONJUNCTION		(Parsetree.conj LITERAL CONJUNCTION)

DISJUNCTION :
	  CONJUNCTION					(CONJUNCTION)
	| CONJUNCTION OR DISJUNCTION	(Parsetree.disj CONJUNCTION DISJUNCTION)

IMPLICATION :
	  DISJUNCTION					(DISJUNCTION)
	| DISJUNCTION IMPL IMPLICATION	(Parsetree.impl DISJUNCTION IMPLICATION)
