diff --git i/Verified-tableaux-for-K-KT-S4/src/lexer.mll w/Verified-tableaux-for-K-KT-S4/src/lexer.mll
new file mode 100644
index 0000000..33be939
--- /dev/null
+++ w/Verified-tableaux-for-K-KT-S4/src/lexer.mll
@@ -0,0 +1,47 @@
+{
+	open Lexing
+	open Parser
+
+	exception SyntaxError of string
+
+	let newline lexbuf =
+		let pos = lexbuf.lex_curr_p in
+		lexbuf.lex_curr_p <-
+			{pos with pos_lnum = pos.pos_lnum +1;
+			          pos_bol = pos.pos_cnum}
+
+}
+
+let chiffre = ['0'-'9']
+let ident = chiffre+
+let proposition  = 'p' ident
+let relation = 'r' ident
+let boxe = '[' relation ']'
+let diamond = '<' relation '>'
+
+rule next_token = parse
+| ' ' | '\t' {next_token lexbuf}
+| '\n' | '\r' {newline lexbuf; next_token lexbuf}
+| "%" {comment lexbuf}
+| diamond {Diamond}
+| boxe {Boxe}
+| ";" {SEMICOLON}
+| "(" { LPAR}
+| ")" { RPAR}
+| "~" {Not}
+| "&" {Conj}
+| "|" {Dij}
+| "<->" {Equiv}
+| "->" {Impl}
+| "true" {TRUE}
+| "false" {FALSE}
+| "begin" {BEGIN}
+| "end" {END}
+| eof {EOF}
+| proposition as p {Prop (int_of_string (String.sub p 1 (String.length p -1)))}
+| _ as s { raise (SyntaxError  ("illegal character: " ^ (String.make 1 s))) }
+
+and comment = parse
+| '\n' {newline lexbuf; next_token lexbuf}
+| eof {EOF}
+| _ {comment lexbuf}
diff --git i/Verified-tableaux-for-K-KT-S4/src/main.ml w/Verified-tableaux-for-K-KT-S4/src/main.ml
new file mode 100644
index 0000000..7303058
--- /dev/null
+++ w/Verified-tableaux-for-K-KT-S4/src/main.ml
@@ -0,0 +1,28 @@
+open Printf
+
+let check fml =
+  let result = K.solve_sat fml in
+  match result with
+  | true -> print_endline "SAT"
+  | false -> print_endline "UNSAT"
+;;
+
+let check_file filename =
+  let file_text = open_in filename in
+  let lexbuf = Lexing.from_channel file_text in
+  let fml =
+    try Parser.file Lexer.next_token lexbuf with
+    | Lexer.SyntaxError s ->
+      print_string s;
+      exit 1
+  in
+  check fml
+;;
+
+let () =
+  match Array.length Sys.argv with
+  | 2 -> check_file Sys.argv.(1)
+  | _ ->
+      Printf.eprintf "Usage: %s <input_file>\n" Sys.argv.(0);
+      exit 1
+;;
diff --git i/Verified-tableaux-for-K-KT-S4/src/parser.mly w/Verified-tableaux-for-K-KT-S4/src/parser.mly
new file mode 100644
index 0000000..58e981a
--- /dev/null
+++ w/Verified-tableaux-for-K-KT-S4/src/parser.mly
@@ -0,0 +1,50 @@
+%{
+  open K
+%}
+
+%token SEMICOLON
+%token LPAR RPAR
+%token Diamond Boxe
+%token TRUE FALSE
+%token EOF
+%token Conj
+%token Dij
+%token Impl
+%token Equiv
+%token Not
+%token BEGIN END
+%token <int> Prop
+
+%right Conj
+%right Dij
+%right Impl
+%right Equiv
+%nonassoc Boxe Diamond Not
+
+%start file
+%type <fml> file
+
+%%
+
+file :
+| BEGIN; f = formulas ;END; EOF {f}
+
+formulas:
+| f1 = formula; SEMICOLON; f2 = formulas {Andf (f1, f2)}
+| f = formula {f}
+
+formula:
+| TRUE {Orf (Varf "p", Negf (Varf "p"))}
+| FALSE {Andf (Varf "p", Negf (Varf "p"))}
+| f = atom {f}
+| Not; f = formula {Negf f}
+| f1 = formula; Conj; f2 = formula {Andf (f1,f2)}
+| f1 = formula; Dij; f2 = formula {Orf (f1,f2)}
+| f1 = formula; Impl; f2 = formula {Implf (f1,f2)}
+| f1 = formula; Equiv; f2 = formula {Andf (Implf (f1,f2), Implf (f2,f1))}
+| Boxe; f = formula {Boxf f}
+| Diamond; f = formula {Diaf f}
+
+atom:
+| LPAR; f = formula; RPAR {f}
+| i = Prop; {Varf (string_of_int i)}
